{
  "manifest_version": 3,
  "name": "J-Sub Session Sync",
  "version": "0.1.0",
  "description": "Capture your logged-in j-subculture.com session (incl. httpOnly cookies) and push it to the buyer server.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "*://*.j-subculture.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "J-Sub Session Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
