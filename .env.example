JSUB_BASE_URL=https://www.j-subculture.com
PORT=8787
JSUB_USERNAME=your_dummy_username
JSUB_PASSWORD=your_dummy_password
STORAGE_STATE_PATH=.pw-user/storageState.json
LEDGER_PATH=data/ledger.json
# Bearer token guarding /session, /item/*, /admin/* and /research/*. OPTIONAL:
# if left unset, the server generates a strong token on first start, saves it to
# data/api-token, and prints it once in the logs (use it for the console login).
# Set it explicitly here to pin your own. The server never runs unauthenticated.
# API_TOKEN=change_me_to_a_long_random_secret
RESEARCH_LOG_PATH=data/log.ndjson
RUNS_DIR=artifacts/runs
# API rate limit (per client IP). Requests over RATE_LIMIT_MAX within
# RATE_LIMIT_WINDOW get 429 { "error": "rate_limited" }. Applies before auth.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Optional: route Playwright traffic through a proxy (e.g. to reach the site
# from a WAF-clean IP). Leave unset to connect directly. Also used as the SOCKS
# tunnel for the raw-HTTP engine below.
# PROXY_URL=socks5://127.0.0.1:1080
# Preview/buy engine: set to 1 to use the browserless raw-HTTP client (fast,
# 1 request instead of a full render). Unset/0 uses the Playwright browser
# (the default/fallback). Raw HTTP reuses the same session cookies + PROXY_URL.
# RAW_HTTP=1
TELEGRAM_BOT_TOKEN=your_bot_token
SQLITE_PATH=data/app.db
# Default RUB cost = (priceJPY + PLAN_FEE_JPY) × RUB_PER_JPY × (1 + MARKUP).
# These are only DEFAULTS — admins can override rate/markup/fee live via the
# bot (/rate /markup /fee), stored in the settings table.
RUB_PER_JPY=0.68
MARKUP=0
PLAN_FEE_JPY=400
TELEGRAM_ADMIN_IDS=
